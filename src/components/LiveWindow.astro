---
import Arrow from './Arrow.astro';
---
<section class="lw" id="lw" data-header-dark="0">
  <div class="lw__sticky">
    <canvas class="lw__canvas" id="lw-canvas" aria-hidden="true"></canvas>
    <div class="lw__fallback" aria-hidden="true"></div>

    <!-- interior wall + window frame (we're standing inside, looking out) -->
    <div class="lw__room" id="lw-room" aria-hidden="true">
      <div class="lw__wall lw__wall--t"></div>
      <div class="lw__wall lw__wall--b"><div class="lw__sill"></div></div>
      <div class="lw__wall lw__wall--l"></div>
      <div class="lw__wall lw__wall--r"></div>
      <div class="lw__frame">
        <div class="lw__mull lw__mull--1"></div>
        <div class="lw__mull lw__mull--2"></div>
        <div class="lw__sheen" id="lw-sheen"></div>
      </div>
    </div>

    <div class="lw__ui wrap">
      <div class="lw__live" id="lw-live" aria-live="polite">
        <span class="lw__pulse"></span>
        <span class="label" id="lw-live-text">Live · Newton Abbot</span>
      </div>

      <div class="lw__copy" id="lw-copy">
        <p class="label lw__kicker">Windows · Doors · Conservatories — South Devon, since 1988</p>
        <h1 class="lw__h">
          <span class="split-line"><span style="--d:.15s">Let the light in.</span></span>
          <span class="split-line"><span style="--d:.27s"><em>Keep the weather out.</em></span></span>
        </h1>
        <p class="lw__sub" id="lw-sub">This view is rendered live from the real position of the sun over Newton Abbot.</p>
        <div class="lw__ctas">
          <a class="btn btn--light" href="/plan/" data-magnet>Plan your project <Arrow /></a>
          <a class="btn btn--ghost-light" href="/visit/">Visit the showroom</a>
        </div>
      </div>

      <div class="lw__moods" role="group" aria-label="Change the view outside">
        <span class="label lw__moods-k">Look outside</span>
        <div class="seg seg--glass" id="lw-moods">
          <button type="button" data-mood="live" aria-pressed="true">Live</button>
          <button type="button" data-mood="dawn" aria-pressed="false">Dawn</button>
          <button type="button" data-mood="day" aria-pressed="false">Midday</button>
          <button type="button" data-mood="golden" aria-pressed="false">Golden hour</button>
          <button type="button" data-mood="rain" aria-pressed="false">Devon rain</button>
          <button type="button" data-mood="night" aria-pressed="false">Night</button>
        </div>
      </div>
    </div>

    <div class="lw__scroll" aria-hidden="true"><span></span>Scroll to step through</div>
  </div>
</section>

<style>
  .lw { position: relative; height: 210vh; background: #0c1618; color: var(--paper); }
  .lw__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .lw__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .lw__fallback { position: absolute; inset: 0; background: linear-gradient(180deg, #5d7896 0%, #c9b9a7 46%, #2f4a4a 47%, #1b2a22 100%); opacity: 0; }
  :global(.no-gl) + .lw__fallback { opacity: 1; }

  .lw__room { position: absolute; inset: 0; pointer-events: none; transform-origin: 50% 46%; will-change: transform; --fw: clamp(10px, 1.1vw, 16px); --mx: clamp(14px, 3.2vw, 48px); --mt: calc(var(--header-h) + 6px); --mb: clamp(70px, 12vh, 120px); }
  .lw__wall { position: absolute; background: #e9e2d4; }
  .lw__wall::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.18), rgba(0,0,0,0) 30%, rgba(0,0,0,0) 70%, rgba(0,0,0,.18)); }
  .lw__wall--t { left: 0; right: 0; top: 0; height: var(--mt); background: linear-gradient(#d9d1c1, #e6dfd0); }
  .lw__wall--b { left: 0; right: 0; bottom: 0; height: var(--mb); background: linear-gradient(#ddd5c5, #cfc6b4); }
  .lw__wall--l { left: 0; top: 0; bottom: 0; width: var(--mx); background: linear-gradient(90deg, #d3cab9, #e2dbcc); }
  .lw__wall--r { right: 0; top: 0; bottom: 0; width: var(--mx); background: linear-gradient(-90deg, #d3cab9, #e2dbcc); }
  .lw__sill { position: absolute; left: calc(var(--mx) - 18px); right: calc(var(--mx) - 18px); top: 0; height: 16px; background: linear-gradient(#fbf9f4, #e4ddcf); box-shadow: 0 10px 22px -8px rgba(0,0,0,.35); }
  .lw__frame {
    position: absolute; left: var(--mx); right: var(--mx); top: var(--mt); bottom: var(--mb);
    border: var(--fw) solid #1f2729;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.08), inset 0 18px 30px -18px rgba(0,0,0,.6), 0 0 0 1px rgba(0,0,0,.35), 0 0 0 7px rgba(0,0,0,.06);
    background: transparent;
  }
  .lw__frame::before { /* reveal depth shadow on glass edges */
    content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 60px rgba(0,0,0,.28); }
  .lw__mull { position: absolute; top: 0; bottom: 0; width: var(--fw); background: linear-gradient(90deg, #171e20, #2a3436 50%, #171e20); box-shadow: 0 0 0 1px rgba(0,0,0,.25); }
  .lw__mull--1 { left: calc(33.33% - var(--fw) / 2); }
  .lw__mull--2 { left: calc(66.66% - var(--fw) / 2); }
  .lw__sheen { position: absolute; inset: 0; background: linear-gradient(112deg, transparent 32%, rgba(255,255,255,.08) 40%, transparent 47%, transparent 58%, rgba(255,255,255,.05) 62%, transparent 66%); background-size: 200% 100%; background-position: var(--sx, 50%) 0; mix-blend-mode: screen; }
  @media (max-width: 760px) { .lw__mull--2 { display: none; } .lw__mull--1 { left: calc(50% - var(--fw) / 2); } }

  .lw__ui { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr auto; padding-top: calc(var(--header-h) + 22px); padding-bottom: clamp(84px, 13vh, 132px); pointer-events: none; }
  .lw__ui > * { pointer-events: auto; }
  .lw__live { justify-self: end; display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; margin-right: clamp(0px, 1vw, 12px); border-radius: 999px; background: rgba(12,22,24,.32); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,.14); }
  .lw__pulse { width: 7px; height: 7px; border-radius: 50%; background: #9fe0a8; box-shadow: 0 0 0 0 rgba(159,224,168,.6); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(159,224,168,.55); } 70% { box-shadow: 0 0 0 10px rgba(159,224,168,0); } 100% { box-shadow: 0 0 0 0 rgba(159,224,168,0); } }
  .lw__copy { align-self: end; padding: 0 clamp(4px, 2vw, 32px) clamp(10px, 2vh, 26px); max-width: 980px; text-shadow: 0 2px 30px rgba(0,0,0,.35); }
  .lw__copy { position: relative; isolation: isolate; }
  .lw__copy::before { content: ''; position: absolute; inset: -18% -30% -25% -20%; z-index: -1; background: radial-gradient(closest-side, rgba(8,16,18,.58), rgba(8,16,18,0)); pointer-events: none; }
  .lw__kicker { margin-bottom: 18px; }
  .lw__h { font-size: clamp(2.9rem, 8.4vw, 8.6rem); line-height: .94; letter-spacing: -0.04em; }
  .lw__h em { font-weight: 280; color: color-mix(in srgb, var(--sun) 70%, white); }
  .lw__sub { margin: 22px 0 0; max-width: 52ch; text-wrap: pretty; font-size: clamp(15px, 1.2vw, 17px); min-height: 3em; }
  .lw__ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .lw__moods { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 0 clamp(4px, 2vw, 32px); }
  .lw__moods-k { text-shadow: 0 1px 12px rgba(0,0,0,.6); }
  .seg--glass button { color: var(--paper); border-color: rgba(255,255,255,.28); background: rgba(12,22,24,.28); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); min-height: 34px; padding: 0 12px; }
  .seg--glass button:hover { border-color: var(--paper); }
  .seg--glass button[aria-pressed='true'] { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .lw__scroll { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); color: #4a4336; font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; display: flex; align-items: center; gap: 10px; }
  .lw__scroll span { width: 1px; height: 26px; background: currentColor; position: relative; overflow: hidden; }
  .lw__scroll span::after { content: ''; position: absolute; left: 0; top: -100%; width: 1px; height: 100%; background: var(--clay); animation: drip 2s var(--ease-io) infinite; }
  @keyframes drip { to { top: 100%; } }

  @media (max-width: 760px) {
    .lw { height: 180vh; }
    .lw__ui { padding-bottom: 92px; }
    .lw__moods { gap: 8px; }
    .lw__moods-k { display: none; }
    .seg--glass { flex-wrap: nowrap; overflow-x: auto; max-width: 100%; scrollbar-width: none; padding-bottom: 2px; }
    .seg--glass button { flex: none; }
    .lw__live { justify-self: start; margin-left: 4px; }
    .lw__scroll { display: none; }
    .lw__copy, .lw__moods { padding-inline: 18px; }
    .lw__live { margin-left: 18px; }
    .lw__h { font-size: clamp(2.5rem, 11vw, 3.4rem); }
    .seg--glass button { min-height: 40px; }
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .lw__h { font-size: clamp(2rem, 11vh, 3.6rem); }
    .lw__kicker { display: none; }
    .lw__sub { margin-top: 10px; min-height: 0; }
    .lw__ui { padding-top: calc(var(--header-h) + 8px); padding-bottom: 56px; }
    .lw__ctas { margin-top: 12px; }
  }
  .lw.is-static .lw__moods, .lw.is-static .lw__live { display: none; }
  @media (prefers-reduced-motion: reduce) { .lw { height: 100vh; height: 100svh; } .lw__scroll { display: none; } }
</style>

<script>
  import { initSky } from '../scripts/sky.js';
  const canvas = document.getElementById('lw-canvas');
  const room = document.getElementById('lw-room');
  const copy = document.getElementById('lw-copy');
  const sub = document.getElementById('lw-sub');
  const liveTxt = document.getElementById('lw-live-text');
  const sheen = document.getElementById('lw-sheen');
  const section = document.getElementById('lw');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  requestAnimationFrame(() => copy.classList.add('is-in'));

  const lines = {
    live: (d) => {
      if (d.rain > 0.3) { const ph = { Drizzle: 'drizzly', Rain: 'raining', 'Heavy rain': 'pouring', Showers: 'showery', Thunderstorm: 'stormy', Snow: 'snowing' }[d.label] || 'raining'; return `It's ${ph} in Newton Abbot right now. Warm and dry on this side of the glass.`; }
      if (d.alt < -6) return `Night over South Devon. Sunrise in Newton Abbot at ${d.sunrise}.`;
      if (d.alt < 8 && d.alt >= -6) return `Low sun over Newton Abbot — sunset today at ${d.sunset}.`;
      return `Daylight over Newton Abbot${d.temp != null ? `, ${d.temp}°C` : ''}. Sunset today at ${d.sunset}.`;
    },
    dawn: () => 'First light over the coast. Rooms facing east catch it first.',
    day: () => 'Midday in South Devon. Big glass, bright rooms.',
    golden: () => 'Golden hour, from a west-facing window. The best seat in the house.',
    rain: () => 'Devon rain, sideways. Sealed, warm and dry on this side of the glass.',
    night: () => 'After dark, the view turns inward. Glazing that keeps the warmth in.',
  };

  let mood = 'live';
  let lastLive = null;
  const sky = initSky(canvas, {
    onLive: (d) => {
      lastLive = d;
      liveTxt.textContent = `Live · Newton Abbot · ${d.time}${d.temp != null ? ` · ${d.temp}°C` : ''}${d.label ? ` · ${d.label}` : ''}`;
      if (mood === 'live') sub.textContent = lines.live(d);
    },
  });
  if (sky) {
    const d = sky.describe();
    liveTxt.textContent = `Live · Newton Abbot · ${d.time}`;
    sub.textContent = lines.live(d);
    setInterval(() => {
      const n = sky.describe();
      const w = lastLive || {};
      liveTxt.textContent = `Live · Newton Abbot · ${n.time}${w.temp != null ? ` · ${w.temp}°C` : ''}${w.label ? ` · ${w.label}` : ''}`;
      if (mood === 'live') sub.textContent = lines.live({ ...n, temp: w.temp, label: w.label, rain: w.rain || 0 });
    }, 30000);
  } else {
    section.classList.add('is-static');
    sub.textContent = 'An illustrated view from a Newton Abbot window, looking out towards the coast.';
  }

  document.getElementById('lw-moods').addEventListener('click', (e) => {
    const b = e.target.closest('button[data-mood]');
    if (!b) return;
    mood = b.dataset.mood;
    document.querySelectorAll('#lw-moods button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    sky?.setMood(mood);
    if (!sky) return;
    sub.textContent = mood === 'live' ? lines.live({ ...sky.describe(), ...(lastLive ? { temp: lastLive.temp, label: lastLive.label, rain: lastLive.rain } : {}) }) : lines[mood]();
  });

  addEventListener('pointermove', (e) => { sheen.style.setProperty('--sx', `${(e.clientX / innerWidth) * 100}%`); }, { passive: true });

  // Scroll: step through the window
  function onScroll() {
    const r = section.getBoundingClientRect();
    const total = section.offsetHeight - innerHeight;
    const p = Math.min(1, Math.max(0, -r.top / total));
    const e = p * p * (3 - 2 * p);
    if (!reduce) {
      room.style.transform = `scale(${1 + e * 1.9})`;
      room.style.opacity = String(1 - Math.max(0, (e - 0.55) / 0.4));
      copy.style.transform = `translateY(${-e * 60}px)`;
      copy.style.opacity = String(1 - Math.max(0, (p - 0.45) / 0.35));
    }
    sky?.setZoom(e);
    const dk = e > 0.42 ? '1' : '0';
    if (section.dataset.headerDark !== dk) { section.dataset.headerDark = dk; dispatchEvent(new Event('scroll')); }
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
