---
// South West England, projected from real coordinates.
const S = 200, LAT0 = 51.6, LON0 = -5.8, K = Math.cos((50.7 * Math.PI) / 180);
const P = (lat, lon) => [((lon - LON0) * K * S).toFixed(1), ((LAT0 - lat) * S).toFixed(1)];
const coast = [
  [51.5,-2.7],[51.4,-2.85],[51.35,-2.98],[51.22,-3.05],[51.2,-3.2],[51.21,-3.47],[51.23,-3.83],[51.21,-4.12],[51.17,-4.22],[51.08,-4.2],[51.03,-4.25],[51.0,-4.4],[51.02,-4.52],[50.95,-4.53],[50.83,-4.55],[50.67,-4.75],[50.58,-4.85],[50.54,-4.94],[50.45,-5.03],[50.41,-5.08],[50.33,-5.2],[50.26,-5.3],[50.21,-5.48],[50.17,-5.62],[50.13,-5.71],[50.07,-5.71],[50.04,-5.62],[50.1,-5.54],[50.12,-5.47],[50.08,-5.32],[50.0,-5.25],[49.96,-5.2],[50.04,-5.09],[50.1,-5.05],[50.15,-5.07],[50.18,-4.97],[50.22,-4.87],[50.27,-4.78],[50.33,-4.65],[50.33,-4.52],[50.35,-4.3],[50.37,-4.14],[50.31,-4.03],[50.28,-3.87],[50.22,-3.78],[50.22,-3.64],[50.3,-3.58],[50.39,-3.5],[50.46,-3.53],[50.54,-3.49],[50.62,-3.41],[50.68,-3.23],[50.7,-3.07],[50.72,-2.94],[50.7,-2.75],[50.63,-2.58],[50.55,-2.45],[50.51,-2.46],[50.57,-2.42],[50.61,-2.45],[50.62,-2.25],[50.59,-2.05],[50.61,-1.96],[50.67,-1.94],[50.71,-1.98],[50.72,-1.88],[50.73,-1.74],[50.85,-1.82],[50.97,-1.95],[51.05,-2.25],[51.2,-2.3],[51.35,-2.3],[51.45,-2.55],
];
const borders = [
  [[50.95,-4.53],[50.85,-4.45],[50.75,-4.4],[50.6,-4.3],[50.5,-4.22],[50.37,-4.18]],
  [[51.22,-3.73],[51.1,-3.72],[51.0,-3.55],[50.95,-3.3],[50.9,-3.1],[50.86,-2.95],[50.78,-2.95],[50.72,-2.94]],
  [[50.86,-2.95],[50.88,-2.75],[50.93,-2.55],[51.0,-2.4],[51.05,-2.25]],
];
const counties = [
  { n: 'Cornwall', at: [50.42, -4.95] }, { n: 'Devon', at: [50.78, -3.85] },
  { n: 'Somerset', at: [51.12, -2.85] }, { n: 'Dorset', at: [50.8, -2.3] },
];
const NA = [50.5281, -3.6101];
const towns = [
  ['Exeter', 50.7184, -3.5339], ['Torquay', 50.4619, -3.5253], ['Paignton', 50.4353, -3.565], ['Teignmouth', 50.5469, -3.4969], ['Dawlish', 50.5806, -3.466],
  ['Totnes', 50.4319, -3.684], ['Bovey Tracey', 50.5925, -3.6762], ['Ashburton', 50.516, -3.7553], ['Dartmouth', 50.3514, -3.5794], ['Kingsbridge', 50.2846, -3.7768],
  ['Ivybridge', 50.3897, -3.9204], ['Plymouth', 50.3755, -4.1427], ['Tavistock', 50.5497, -4.1442], ['Okehampton', 50.7389, -4.0039], ['Exmouth', 50.6198, -3.4137],
  ['Honiton', 50.7997, -3.1887], ['Tiverton', 50.903, -3.4882], ['Barnstaple', 51.08, -4.0583], ['Bideford', 51.0167, -4.2083], ['Launceston', 50.637, -4.36],
  ['Bodmin', 50.4715, -4.7243], ['Truro', 50.2632, -5.051], ['Penzance', 50.1186, -5.5371], ['Taunton', 51.015, -3.1029], ['Yeovil', 50.9421, -2.6336],
  ['Lyme Regis', 50.7253, -2.9365], ['Dorchester', 50.7154, -2.4371],
];
const coastD = 'M' + coast.map((c) => P(...c).join(' ')).join(' L') + ' Z';
const na = P(...NA);
const mi = (m) => ((m * 1.609) / 111) * S;
const labelTowns = ['Exeter', 'Plymouth', 'Torquay', 'Truro', 'Barnstaple', 'Taunton', 'Dorchester', 'Penzance'];
const { compact = false } = Astro.props;
---
<div class:list={['cmap', { 'cmap--compact': compact }]}>
  <div class="cmap__fig">
    <svg viewBox="0 0 540 340" class="cmap__svg" id="cmap-svg" role="img" aria-label="Map of South West England showing Coastal's showroom in Newton Abbot and the counties covered: Cornwall, Devon, Somerset and Dorset.">
      <defs>
        <pattern id="cmap-dots" width="5" height="5" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".7" fill="currentColor" opacity=".35" /></pattern>
        <clipPath id="cmap-clip"><path d={coastD} /></clipPath>
      </defs>
      <path d={coastD} fill="url(#cmap-dots)" />
      <path d={coastD} fill="none" stroke="currentColor" stroke-opacity=".6" />
      {borders.map((b) => <path d={'M' + b.map((c) => P(...c).join(' ')).join(' L')} fill="none" stroke="currentColor" stroke-opacity=".35" stroke-dasharray="2 3" />)}
      <g clip-path="url(#cmap-clip)" class="cmap__rings">
        {[25, 50, 100].map((m) => <circle cx={na[0]} cy={na[1]} r={mi(m).toFixed(1)} fill="none" stroke="var(--clay)" stroke-opacity=".5" />)}
      </g>
      {[25, 50, 100].map((m) => <text x={(+na[0] + mi(m) * 0.7071 + 3).toFixed(1)} y={(+na[1] - mi(m) * 0.7071 - 3).toFixed(1)} class="cmap__ring-t">{m} mi</text>)}
      {counties.map((c) => { const p = P(...c.at); return <text x={p[0]} y={p[1]} class="cmap__county" text-anchor="middle">{c.n}</text>; })}
      {towns.filter((t) => labelTowns.includes(t[0])).map((t) => { const p = P(t[1], t[2]); return <g class="cmap__town"><circle cx={p[0]} cy={p[1]} r="1.8" /><text x={+p[0] + 4} y={+p[1] + 3}>{t[0]}</text></g>; })}
      <line id="cmap-line" x1={na[0]} y1={na[1]} x2={na[0]} y2={na[1]} stroke="var(--clay)" stroke-width="1.4" />
      <circle id="cmap-target" cx={na[0]} cy={na[1]} r="0" fill="var(--clay)" />
      <g class="cmap__home">
        <circle cx={na[0]} cy={na[1]} r="9" class="cmap__pulse" />
        <circle cx={na[0]} cy={na[1]} r="4.2" fill="var(--clay)" stroke="var(--paper)" stroke-width="1.5" />
        <text x={+na[0] + 10} y={+na[1] - 8} class="cmap__home-t">Showroom · Newton Abbot</text>
      </g>
    </svg>
  </div>
  <div class="cmap__tool">
    <label class="field">
      <span class="field__label">How far is the showroom from you?</span>
      <select id="cmap-town">
        <option value="">Choose your nearest town</option>
        {towns.slice().sort((a, b) => a[0].localeCompare(b[0])).map((t) => <option value={`${t[1]},${t[2]}`}>{t[0]}</option>)}
      </select>
    </label>
    <p class="cmap__out" id="cmap-out" aria-live="polite">Our installation teams cover Cornwall, Devon, Somerset and Dorset — and the areas in between.</p>
  </div>
</div>

<style>
  .cmap { display: grid; gap: 22px; }
  .cmap__svg { width: 100%; height: auto; overflow: visible; color: currentColor; }
  .cmap__county { font-family: var(--f-display); font-style: italic; font-size: 15px; fill: currentColor; opacity: .75; }
  .cmap__town circle { fill: currentColor; }
  .cmap__town text, .cmap__ring-t { font-family: var(--f-mono); font-size: 7.5px; letter-spacing: .06em; fill: currentColor; opacity: .7; text-transform: uppercase; }
  .cmap__ring-t { fill: var(--clay); opacity: 1; }
  .cmap__home-t { font-family: var(--f-mono); font-size: 8.5px; letter-spacing: .08em; text-transform: uppercase; fill: currentColor; font-weight: 600; }
  .cmap__pulse { fill: var(--clay); opacity: .25; transform-origin: center; transform-box: fill-box; animation: cpulse 2.6s var(--ease) infinite; }
  @keyframes cpulse { 0% { transform: scale(.4); opacity: .5; } 100% { transform: scale(2.4); opacity: 0; } }
  #cmap-line { transition: all 1s var(--ease); }
  #cmap-target { transition: all 1s var(--ease); }
  .cmap__out { font-family: var(--f-display); font-size: clamp(1.3rem, 2vw, 1.7rem); line-height: 1.25; margin: 0; max-width: 34ch; }
  .cmap__out b { font-weight: 400; font-style: italic; color: var(--clay); }
  .cmap__tool { display: grid; gap: 18px; max-width: 520px; }
</style>

<script>
  const NA = [50.5281, -3.6101];
  const S = 200, LAT0 = 51.6, LON0 = -5.8, K = Math.cos((50.7 * Math.PI) / 180);
  const P = (lat, lon) => [(lon - LON0) * K * S, (LAT0 - lat) * S];
  const hav = (a, b) => {
    const R = 3958.8, r = Math.PI / 180;
    const dLat = (b[0] - a[0]) * r, dLon = (b[1] - a[1]) * r;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  };
  const sel = document.getElementById('cmap-town');
  const out = document.getElementById('cmap-out');
  const line = document.getElementById('cmap-line');
  const tgt = document.getElementById('cmap-target');
  sel?.addEventListener('change', () => {
    if (!sel.value) return;
    const [lat, lon] = sel.value.split(',').map(Number);
    const [x, y] = P(lat, lon);
    line.setAttribute('x2', x.toFixed(1)); line.setAttribute('y2', y.toFixed(1));
    tgt.setAttribute('cx', x.toFixed(1)); tgt.setAttribute('cy', y.toFixed(1)); tgt.setAttribute('r', '3');
    const d = hav(NA, [lat, lon]);
    const name = sel.options[sel.selectedIndex].text;
    out.innerHTML = d < 3
      ? `${name} is right on our doorstep — the showroom is <b>minutes away</b>.`
      : `${name} is about <b>${Math.round(d)} miles</b> from the showroom, as the crow flies — well within the area we cover.`;
  });
</script>
