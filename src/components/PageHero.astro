---
const { n = '', kicker = '', title = '', lede = '', meta = [], dark = false, cls = '' } = Astro.props;
---
<section class:list={['phero', cls, { 'section--ink': dark }]} data-header-dark={dark ? '' : undefined}>
  <div class="wrap">
    <div class="phero__meta" data-reveal="fade">
      {n && <span class="label">{n}</span>}
      {kicker && <span class="label label--dim">{kicker}</span>}
      {meta.map((m) => <span class="label label--dim">{m}</span>)}
    </div>
    <div class="phero__grid">
      <div class="phero__main">
        <h1 class="phero__h" data-reveal-lines set:html={title.split('|').map((l, i) => `<span class="split-line"><span style="--d:${(0.08 + i * 0.1).toFixed(2)}s">${l}</span></span>`).join('')}></h1>
        <div class="phero__dim" aria-hidden="true"><i></i><span class="label"><slot name="dim">Made to measure</slot></span><i></i></div>
        {lede && <p class="lede phero__lede" data-reveal style="--d:.35s">{lede}</p>}
        <div class="phero__actions" data-reveal style="--d:.42s"><slot name="actions" /></div>
      </div>
      <div class="phero__art" data-reveal="fade" style="--d:.2s"><slot name="art" /></div>
    </div>
  </div>
</section>

<style>
  .phero__grid { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(28px, 5vw, 80px); align-items: end; }
  .phero__h { font-size: clamp(3rem, min(8vw, 13vh), 8.4rem); max-width: 11ch; }
  .phero__h :global(em) { color: var(--clay); }
  .section--ink .phero__h :global(em) { color: var(--gold); }
  .phero__dim { margin: clamp(20px, 2.4vw, 32px) 0 0; display: flex; align-items: center; gap: 14px; max-width: 640px; }
  .phero__dim i { flex: 1; height: 9px; border-left: 1px solid currentColor; position: relative; opacity: .45; }
  .phero__dim i:last-child { border-left: 0; border-right: 1px solid currentColor; }
  .phero__dim i::after { content: ''; position: absolute; left: 0; right: 0; top: 4px; height: 1px; background: currentColor; }
  .phero__dim .label { font-size: 10px; white-space: nowrap; }
  .phero__lede { margin-top: clamp(20px, 2.4vw, 32px); max-width: 44ch; }
  .phero__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .phero__actions:empty { display: none; }
  .phero__art { color: var(--ink); max-width: min(420px, 58vh); justify-self: end; width: 100%; }
  .section--ink .phero__art { color: var(--paper); }
  @media (max-width: 900px) { .phero__grid { grid-template-columns: 1fr; } .phero__art { justify-self: start; max-width: 300px; } }
</style>
