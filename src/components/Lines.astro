---
// Renders a heading as masked lines that rise into place.
// lines: array of strings; wrap a word in *asterisks* for italic.
const { lines = [], tag = 'h2', cls = '', delay = 0, step = 0.09, id } = Astro.props;
const Tag = tag;
const fmt = (s) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---
<Tag class={cls} id={id} data-reveal-lines>
  {lines.map((l, i) => (
    <span class="split-line"><span style={`--d:${(delay + i * step).toFixed(2)}s`} set:html={fmt(l)} /></span>
  ))}
</Tag>
