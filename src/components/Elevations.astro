---
// Architectural line elevations. Dashed "V" lines follow the drawing convention
// for opening lights: the point of the V marks the hinge side.
const { kind = 'window', cls = '' } = Astro.props;
---
<svg class={`elev draw ${cls}`} viewBox="0 0 200 300" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
  {kind === 'window' && (
    <g>
      <rect x="30" y="50" width="140" height="200" />
      <rect x="38" y="58" width="124" height="184" />
      <line x1="100" y1="58" x2="100" y2="242" />
      <line x1="38" y1="118" x2="162" y2="118" />
      <rect x="44" y="64" width="50" height="48" />
      <path d="M44 64 L69 112 L94 64" stroke-dasharray="3 3" />
      <rect x="106" y="124" width="50" height="112" />
      <path d="M156 124 L106 180 L156 236" stroke-dasharray="3 3" />
      <line x1="22" y1="258" x2="178" y2="258" />
      <line x1="30" y1="270" x2="170" y2="270" />
      <line x1="30" y1="266" x2="30" y2="274" /><line x1="170" y1="266" x2="170" y2="274" />
    </g>
  )}
  {kind === 'door' && (
    <g>
      <rect x="44" y="20" width="112" height="262" />
      <rect x="52" y="28" width="96" height="40" />
      <path d="M60 64a40 40 0 0 1 80 0" />
      <rect x="52" y="74" width="96" height="200" />
      <rect x="62" y="84" width="34" height="58" /><rect x="104" y="84" width="34" height="58" />
      <rect x="62" y="152" width="34" height="112" /><rect x="104" y="152" width="34" height="112" />
      <line x1="76" y1="172" x2="124" y2="172" />
      <rect x="138" y="190" width="5" height="18" />
      <line x1="30" y1="282" x2="170" y2="282" />
      <line x1="36" y1="290" x2="164" y2="290" />
    </g>
  )}
  {kind === 'bifold' && (
    <g>
      <rect x="14" y="60" width="172" height="190" />
      <line x1="57" y1="60" x2="57" y2="250" /><line x1="100" y1="60" x2="100" y2="250" /><line x1="143" y1="60" x2="143" y2="250" />
      <path d="M14 60 L57 155 L14 250" stroke-dasharray="3 3" />
      <path d="M100 60 L57 155 L100 250" stroke-dasharray="3 3" />
      <path d="M100 60 L143 155 L100 250" stroke-dasharray="3 3" />
      <path d="M186 60 L143 155 L186 250" stroke-dasharray="3 3" />
      <line x1="6" y1="262" x2="194" y2="262" />
    </g>
  )}
  {kind === 'conservatory' && (
    <g>
      <path d="M10 150 L100 92 L190 150" />
      <line x1="100" y1="92" x2="100" y2="74" /><circle cx="100" cy="70" r="4" />
      <path d="M20 150 L100 100 L180 150" />
      <line x1="55" y1="128" x2="55" y2="150" /><line x1="145" y1="128" x2="145" y2="150" />
      <rect x="16" y="150" width="168" height="94" />
      <line x1="58" y1="150" x2="58" y2="244" /><line x1="100" y1="150" x2="100" y2="244" /><line x1="142" y1="150" x2="142" y2="244" />
      <line x1="16" y1="176" x2="184" y2="176" />
      <rect x="12" y="244" width="176" height="38" />
      <line x1="12" y1="257" x2="188" y2="257" stroke-dasharray="6 4" /><line x1="12" y1="270" x2="188" y2="270" stroke-dasharray="4 6" />
    </g>
  )}
  {kind === 'porch' && (
    <g>
      <path d="M30 120 L100 70 L170 120 Z" />
      <path d="M44 120 L100 82 L156 120" />
      <rect x="40" y="120" width="120" height="160" />
      <rect x="76" y="140" width="48" height="140" />
      <rect x="84" y="150" width="32" height="46" />
      <rect x="48" y="140" width="20" height="70" /><rect x="132" y="140" width="20" height="70" />
      <rect x="40" y="226" width="36" height="54" /><rect x="124" y="226" width="36" height="54" />
      <line x1="20" y1="280" x2="180" y2="280" />
    </g>
  )}
  {kind === 'roofline' && (
    <g>
      <path d="M8 150 L100 50 L192 150" />
      <path d="M20 150 L100 64 L180 150" />
      <rect x="6" y="150" width="188" height="10" />
      <path d="M2 160 h22 v8 h-22 z" /><path d="M176 160 h22 v8 h-22 z" />
      <line x1="24" y1="160" x2="24" y2="276" />
      <line x1="24" y1="170" x2="176" y2="170" />
      {[184, 198, 212, 226, 240, 254, 268].map((y) => <line x1="24" y1={y} x2="176" y2={y} />)}
      <line x1="176" y1="160" x2="176" y2="276" />
      <rect x="72" y="196" width="56" height="50" />
      <line x1="100" y1="196" x2="100" y2="246" />
      <line x1="190" y1="168" x2="190" y2="282" />
    </g>
  )}
</svg>
<style>
  .elev { width: 100%; height: auto; overflow: visible; stroke-linecap: square; }
</style>
