---
import { COLOURS } from '../lib/door.js';
const groups = ['Timeless', 'Traditional', 'Contemporary', 'Statement'];
const win = (side) => `
<svg viewBox="0 0 240 300" class="dc__svg" aria-hidden="true">
  <defs>
    <pattern id="dc-grain-${side}" width="240" height="8" patternUnits="userSpaceOnUse"><rect width="240" height="8" fill="var(--dc-${side})"/><path d="M0 2 Q60 0 120 3 T240 2" stroke="#000" stroke-opacity=".18" fill="none"/><path d="M0 6 Q80 8 160 5 T240 6" stroke="#fff" stroke-opacity=".08" fill="none"/></pattern>
    <linearGradient id="dc-gl-${side}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${side === 'out' ? '#dbe6ea' : '#f6e7c9'}"/><stop offset=".5" stop-color="${side === 'out' ? '#9cb3bb' : '#d9c4a0'}"/><stop offset=".51" stop-color="${side === 'out' ? '#b9cad0' : '#e8d6b5'}"/><stop offset="1" stop-color="${side === 'out' ? '#6f8790' : '#b39a73'}"/></linearGradient>
  </defs>
  <rect x="0" y="0" width="240" height="300" fill="${side === 'out' ? '#b0573e' : '#ece6db'}"/>
  ${side === 'out' ? Array.from({ length: 14 }, (_, r) => `<line x1="0" y1="${r * 22 + 11}" x2="240" y2="${r * 22 + 11}" stroke="#d9cfbf" stroke-width="2"/>`).join('') : ''}
  <g class="dc__frame dc__frame--${side}">
    <rect x="30" y="30" width="180" height="230" class="dc__fill" />
    <rect x="44" y="44" width="70" height="202" fill="url(#dc-gl-${side})"/>
    <rect x="126" y="44" width="70" height="202" fill="url(#dc-gl-${side})"/>
    <rect x="44" y="44" width="70" height="202" fill="none" stroke="#000" stroke-opacity=".25" stroke-width="2"/>
    <rect x="126" y="44" width="70" height="202" fill="none" stroke="#000" stroke-opacity=".25" stroke-width="2"/>
    <rect x="${side === 'out' ? 186 : 47}" y="140" width="5" height="26" rx="2" fill="#d6dadb"/>
  </g>
  <rect x="22" y="260" width="196" height="12" fill="${side === 'out' ? '#cfcac0' : '#faf8f3'}"/>
</svg>`;
---
<div class="dc" id="dc" style="--dc-out:#f1f0ea;--dc-in:#f1f0ea">
  <div class="dc__views">
    <figure><div set:html={win('out')} /><figcaption class="label">Outside · <span id="dc-out-n">Simply White</span></figcaption></figure>
    <figure><div set:html={win('in')} /><figcaption class="label">Inside · <span id="dc-in-n">Simply White</span></figcaption></figure>
  </div>
  <div class="dc__pick">
    <div class="seg" role="group" aria-label="Choose which face to colour">
      <button type="button" aria-pressed="true" data-face="out">Outside face</button>
      <button type="button" aria-pressed="false" data-face="in">Inside face</button>
      <button type="button" aria-pressed="false" data-same>Match both</button>
    </div>
    {groups.map((g) => (
      <div class="dc__group">
        <span class="label label--dim">{g}</span>
        <div class="dc__sw">
          {COLOURS.filter((c) => c.g === g).map((c) => (
            <button type="button" class:list={['swatch', 'swatch--sm', { 'swatch--grain': c.grain }]} style={`--c:${c.hex}`} data-hex={c.hex} data-n={c.n} data-grain={c.grain ? '1' : ''} title={c.n} aria-label={c.n}></button>
          ))}
        </div>
      </div>
    ))}
    <p class="dc__note">Dual colour lets the outside suit the street while the inside suits the room — Coastal's projects include combinations like anthracite grey outside with white inside. Colours on screen are approximate; see real samples in the showroom.</p>
  </div>
</div>

<style>
  .dc { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(24px, 4vw, 60px); align-items: start; }
  .dc__views { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .dc__views figure { margin: 0; display: grid; gap: 10px; }
  .dc__views :global(.dc__svg) { width: 100%; height: auto; }
  .dc :global(.dc__frame--out .dc__fill) { fill: var(--dc-out); transition: fill .5s; }
  .dc :global(.dc__frame--in .dc__fill) { fill: var(--dc-in); transition: fill .5s; }
  .dc.grain-out :global(.dc__frame--out .dc__fill) { fill: url(#dc-grain-out); }
  .dc.grain-in :global(.dc__frame--in .dc__fill) { fill: url(#dc-grain-in); }
  .dc__pick { display: grid; gap: 18px; }
  .dc__group { display: grid; gap: 8px; }
  .dc__sw { display: flex; flex-wrap: wrap; gap: 8px; }
  .dc :global(.swatch--sm) { width: 36px; height: 36px; }
  .dc__note { font-size: 13.5px; color: var(--ink-mute); margin: 6px 0 0; }
  @media (max-width: 900px) { .dc { grid-template-columns: 1fr; } }
</style>

<script>
  const dc = document.getElementById('dc');
  if (dc) {
    let face = 'out', same = false;
    const faceBtns = dc.querySelectorAll('[data-face], [data-same]');
    faceBtns.forEach((b) => b.addEventListener('click', () => {
      faceBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      same = b.hasAttribute('data-same');
      if (!same) face = b.dataset.face;
    }));
    const paint = (f, hex, n, grain) => {
      dc.style.setProperty(`--dc-${f}`, hex);
      dc.classList.toggle(`grain-${f}`, !!grain);
      document.getElementById(`dc-${f}-n`).textContent = n;
    };
    dc.querySelectorAll('.swatch').forEach((s) => s.addEventListener('click', () => {
      const { hex, n, grain } = s.dataset;
      if (same) { paint('out', hex, n, grain); paint('in', hex, n, grain); }
      else paint(face, hex, n, grain);
    }));
  }
</script>
