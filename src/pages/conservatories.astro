---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Elevations from '../components/Elevations.astro';
import Arrow from '../components/Arrow.astro';

const styles = [
  { k: 'leanto', n: 'Lean-to', t: 'Widely regarded as the clearest option for both modern and traditional homes — sleek lines and a sloping roof give a distinctive Mediterranean feel, and "a cosy space from which to enjoy your garden year round."',
    plan: 'M80 20 V150 H320 V20 Z',
    elev: `<rect x="60" y="190" width="280" height="40"/><rect x="60" y="112" width="280" height="78"/>${[116, 172, 228, 284].map((x) => `<line x1="${x}" y1="112" x2="${x}" y2="190"/>`).join('')}<line x1="60" y1="134" x2="340" y2="134"/><path d="M50 112 L350 112 L350 98 L50 98 Z"/><path d="M50 98 L60 72 L340 72 L350 98"/>` },
  { k: 'victorian', n: 'Victorian', t: 'A central ridge gives a pitched roof, designed with 3 or 5 facets — with a choice of crestings and finials "from low profile to renaissance".',
    plan: 'M80 20 V100 L115 145 L170 168 H230 L285 145 L320 100 V20 Z',
    elev: `<rect x="60" y="190" width="280" height="40"/><path d="M60 122 H340 V190 H60 Z"/><line x1="100" y1="122" x2="100" y2="190"/><line x1="150" y1="122" x2="150" y2="190"/><line x1="250" y1="122" x2="250" y2="190"/><line x1="300" y1="122" x2="300" y2="190"/><line x1="60" y1="140" x2="340" y2="140"/><path d="M52 122 L150 72 L250 72 L348 122"/><line x1="100" y1="122" x2="160" y2="72"/><line x1="150" y1="122" x2="180" y2="72"/><line x1="250" y1="122" x2="220" y2="72"/><line x1="300" y1="122" x2="240" y2="72"/><line x1="200" y1="72" x2="200" y2="58"/><circle cx="200" cy="54" r="4"/>${[160, 175, 190, 210, 225, 240].map((x) => `<circle cx="${x}" cy="68" r="2"/>`).join('')}` },
  { k: 'edwardian', n: 'Edwardian', t: 'A three or four-sided roof — also available in double-hip back, perfect for properties with a lower roofline or for anyone who wants a vaulted ceiling.',
    plan: 'M80 20 V160 H320 V20 Z',
    elev: `<rect x="60" y="190" width="280" height="40"/><rect x="60" y="122" width="280" height="68"/>${[116, 172, 228, 284].map((x) => `<line x1="${x}" y1="122" x2="${x}" y2="190"/>`).join('')}<line x1="60" y1="140" x2="340" y2="140"/><path d="M52 122 L140 70 L260 70 L348 122 Z"/>${[90, 125, 160].map((x, i) => `<line x1="${x}" y1="122" x2="${150 + i * 10}" y2="70"/>`).join('')}${[310, 275, 240].map((x, i) => `<line x1="${x}" y1="122" x2="${250 - i * 10}" y2="70"/>`).join('')}` },
  { k: 'pshape', n: 'P-shaped', t: 'Combines a lean-to (the long part of the P) with a Victorian or Edwardian rounded end. It’s slightly more expensive than other designs, and gives you two distinct shapes in one.',
    plan: 'M40 20 V110 H220 V140 L245 175 L300 190 L335 175 L360 140 V20 Z',
    elev: `<rect x="20" y="190" width="360" height="40"/><rect x="20" y="126" width="200" height="64"/>${[70, 120, 170].map((x) => `<line x1="${x}" y1="126" x2="${x}" y2="190"/>`).join('')}<path d="M12 126 H220 V112 H12 Z"/><rect x="220" y="118" width="160" height="72"/><line x1="260" y1="118" x2="260" y2="190"/><line x1="340" y1="118" x2="340" y2="190"/><path d="M214 118 L270 76 L330 76 L386 118"/><line x1="300" y1="76" x2="300" y2="62"/><circle cx="300" cy="58" r="4"/>` },
  { k: 'gable', n: 'Gable end', t: 'A square or rectangular layout similar to a Georgian design, with a glazed gable front. With its impressive roof height, the conservatory feels bright and spacious.',
    plan: 'M80 20 V160 H320 V20 Z',
    elev: `<rect x="60" y="190" width="280" height="40"/><rect x="60" y="122" width="280" height="68"/>${[116, 172, 228, 284].map((x) => `<line x1="${x}" y1="122" x2="${x}" y2="190"/>`).join('')}<path d="M52 122 L200 36 L348 122 Z"/><path d="M68 118 L200 44 L332 118"/>${[-60, -30, 0, 30, 60].map((a) => `<line x1="200" y1="118" x2="${(200 + Math.tan((a * Math.PI) / 180) * 60).toFixed(0)}" y2="${a === 0 ? 46 : Math.abs(a) === 30 ? 72 : 100}"/>`).join('')}<path d="M180 118 A20 20 0 0 1 220 118"/>` },
];
---
<Base title="Conservatories" description="Lean-to, Victorian, Edwardian, P-shaped and gable-end conservatories, hup! extensions, replacement conservatory roofs, porches and Deponti verandas across Devon.">
  <PageHero n="03" kicker="Conservatories" meta={['Styles · roofs · hup!', 'Porches & verandas']} title="Rooms made|<em>of light.</em>" lede="Conservatories are lifestyle enhancements, meant to bring light, space and a slice of nature into your everyday living — designed to suit the architecture of your home and built by our own teams.">
    <Fragment slot="dim">Five styles · three roof types</Fragment>
    <Fragment slot="actions"><a class="btn" href="/light-lab/">Test the light in the Light Lab <Arrow /></a><a class="btn btn--ghost" href="#roofs">Replacing a roof?</a></Fragment>
    <Fragment slot="art"><Elevations kind="conservatory" /></Fragment>
  </PageHero>

  <section class="section section--bone" aria-labelledby="st-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="label sec-head__kicker">Conservatory styles</p>
          <h2 id="st-h" data-reveal>Five shapes.<br /><em>Seen from above and in front.</em></h2>
        </div>
        <p class="lede" data-reveal style="--d:.1s">Every conservatory starts with a footprint. Choose a style to see its plan and elevation — the same drawings your designer will talk you through.</p>
      </div>
      <div class="cs" id="cs">
        <div class="cs__tabs seg" role="tablist" aria-label="Conservatory style">
          {styles.map((s, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>{s.n}</button>)}
        </div>
        <div class="cs__body">
          <figure class="cs__fig">
            <figcaption class="label label--dim">Plan · house wall at top</figcaption>
            <svg viewBox="0 0 400 210" class="cs__svg" aria-hidden="true">
              <rect x="0" y="0" width="400" height="20" class="cs__house" />
              <path id="cs-plan" d={styles[0].plan} class="cs__plan" />
              <text x="200" y="14" text-anchor="middle" class="cs__t">HOUSE</text>
            </svg>
          </figure>
          <figure class="cs__fig">
            <figcaption class="label label--dim">Front elevation</figcaption>
            <svg viewBox="0 0 400 240" class="cs__svg" aria-hidden="true">
              <rect x="0" y="20" width="400" height="210" class="cs__wallbg" />
              <g id="cs-elev" class="cs__elev" set:html={styles[0].elev}></g>
              <line x1="0" y1="230" x2="400" y2="230" class="cs__ground" />
            </svg>
          </figure>
          <div class="cs__copy">
            {styles.map((s, i) => <div class="cs__txt" data-i={i} hidden={i !== 0}><h3>{s.n}</h3><p>{s.t}</p></div>)}
            <ul class="spec">
              <li>Bespoke design, with every element crafted for your home</li>
              <li>Advanced glazing, with aluminium or uPVC framing</li>
              <li>A construction process designed to minimise disruption</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script type="application/json" id="cs-data" set:html={JSON.stringify(styles.map((s) => ({ plan: s.plan, elev: s.elev })))} />

  <section class="section roofs" id="roofs" aria-labelledby="roofs-h">
    <div class="wrap roofs__grid">
      <div>
        <p class="label sec-head__kicker">Replacement conservatory roofs</p>
        <h2 id="roofs-h" data-reveal>Keep the room.<br /><em>Change the roof.</em></h2>
        <p class="lede" data-reveal style="--d:.08s">"Enjoy a cooler summer and a warmer winter with our innovative designs that cut down on energy costs." Replacing just the roof can transform how an existing conservatory feels — ask us whether yours is suitable.</p>
        <ul class="spec" data-reveal style="--d:.14s">
          <li><span><b>Tiled roofs</b> — for a traditional, solid look</span></li>
          <li><span><b>Glazed roofs</b> — advanced glazing that keeps heat in during winter and out during summer</span></li>
          <li><span><b>Polycarbonate roofs</b> — engineered to meet stringent energy efficiency standards</span></li>
          <li>Resistant to discolouration, warping and leaking</li>
        </ul>
        <div class="roofs__ctas" data-reveal style="--d:.2s">
          <a class="btn" href="/plan/?type=transform&p=roof">Ask about a new roof <Arrow /></a>
          <a class="link" href="/light-lab/">Compare roofs in the Light Lab</a>
        </div>
      </div>
      <figure class="ba" id="ba" data-reveal>
        <svg viewBox="0 0 600 420" class="ba__svg" aria-label="Illustration: a conservatory with its old polycarbonate roof on the left and a new tiled roof on the right. Drag the handle to compare." role="img">
          <defs>
            <pattern id="ba-poly" width="14" height="14" patternUnits="userSpaceOnUse"><rect width="14" height="14" fill="#e9eef0"/><line x1="0" y1="0" x2="0" y2="14" stroke="#c9d3d6" stroke-width="5"/></pattern>
            <pattern id="ba-tile" width="30" height="16" patternUnits="userSpaceOnUse"><rect width="30" height="16" fill="#3f4447"/><path d="M0 15.5 H30 M15 0 V8 M0 8 H30 M7 8 V16 M22 8 V16" stroke="#2a2e30" stroke-width="1.4"/></pattern>
            <clipPath id="ba-clip"><rect id="ba-cliprect" x="300" y="0" width="300" height="420" /></clipPath>
          </defs>
          <rect width="600" height="420" fill="#efe9dd" />
          <rect x="0" y="30" width="600" height="330" fill="#e2d9c8" />
          <g class="ba__con">
            <rect x="90" y="300" width="420" height="60" fill="#c4b9a6" />
            {[0, 1, 2, 3, 4, 5].map((r) => <line x1="90" y1={300 + r * 10} x2="510" y2={300 + r * 10} stroke="#b0a591" />)}
            <rect x="90" y="190" width="420" height="110" fill="#cfdde1" stroke="#fbfbf8" stroke-width="8" />
            {[160, 230, 300, 370, 440].map((x) => <line x1={x} y1="190" x2={x} y2="300" stroke="#fbfbf8" stroke-width="7" />)}
            <line x1="90" y1="214" x2="510" y2="214" stroke="#fbfbf8" stroke-width="6" />
          </g>
          <path d="M76 190 L220 92 L380 92 L524 190 Z" fill="url(#ba-poly)" stroke="#fbfbf8" stroke-width="7" />
          {[150, 220, 300, 380, 450].map((x, i) => <line x1={x} y1="190" x2={[200, 245, 300, 355, 400][i]} y2="92" stroke="#fbfbf8" stroke-width="5" />)}
          <g clip-path="url(#ba-clip)">
            <path d="M70 194 L220 88 L380 88 L530 194 Z" fill="url(#ba-tile)" />
            <path d="M70 194 L220 88 L380 88 L530 194" fill="none" stroke="#2a2e30" stroke-width="3" />
            <rect x="66" y="192" width="468" height="12" fill="#f3f2ee" />
            <rect x="330" y="122" width="56" height="40" fill="#bfd0d6" stroke="#2a2e30" stroke-width="3" />
            <rect x="214" y="80" width="172" height="10" fill="#2f3335" />
          </g>
          <line id="ba-line" x1="300" y1="0" x2="300" y2="420" stroke="var(--ink)" stroke-width="2" />
          <g id="ba-knob" transform="translate(300 380)">
            <circle r="18" fill="var(--ink)" /><path d="M-6 -5 L-11 0 L-6 5 M6 -5 L11 0 L6 5" stroke="var(--paper)" stroke-width="2" fill="none" />
          </g>
          <text x="20" y="24" class="ba__t">BEFORE · POLYCARBONATE</text>
          <text x="580" y="24" class="ba__t" text-anchor="end">AFTER · TILED</text>
        </svg>
        <input type="range" min="0" max="100" value="50" class="ba__range" aria-label="Compare old and new roof" id="ba-range" />
        <figcaption class="coords">Illustration only</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--ink hup" data-header-dark id="hup" aria-labelledby="hup-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="label sec-head__kicker">hup! by Ultraframe</p>
          <h2 id="hup-h" data-reveal>The better way<br /><em>to build.</em></h2>
        </div>
        <p class="lede" data-reveal style="--d:.1s">hup! is an insulated panel system for conservatory transformations, extensions, conservatories and garden homes — and one team handles the build from start to finish.</p>
      </div>
      <div class="hup__grid">
        {[
          ['Design flexibility', 'A choice of roof systems, coupled with walls, windows and doors in almost any design.'],
          ['Faster to build', 'hup! says its rapid connection technology means a hup! can be built five times faster than with traditional building methods and materials.'],
          ['Energy efficiency', 'hup! states five times the energy efficiency of the average UK home, with zero-waste manufacturing.'],
          ['One supplier, one project', 'One team will handle the build, from start to finish.'],
        ].map(([h, t], i) => <div class="hup__c" data-reveal style={`--d:${i * 0.06}s`}><span class="idx">0{i + 1}</span><h3 class="h4">{h}</h3><p>{t}</p></div>)}
      </div>
      <div class="hup__types">
        {['Conservatory transformations', 'Extensions', 'hup! conservatories', 'Garden homes'].map((t) => <span class="chip">{t}</span>)}
      </div>
      <p class="hup__note">Performance figures are hup!'s own claims, as presented on Coastal's hup! page. A hup! case study describes "walls up by lunchtime and watertight in two days".</p>
      <a class="btn btn--light" href="/plan/?type=transform&p=hup">Book a design appointment <Arrow /></a>
    </div>
  </section>

  <section class="section" id="porches" aria-labelledby="po-h">
    <div class="wrap pv">
      <div class="pv__art" data-reveal><Elevations kind="porch" /></div>
      <div>
        <p class="label sec-head__kicker">Porches</p>
        <h2 id="po-h" data-reveal>A warmer welcome<br /><em>at the front.</em></h2>
        <p class="lede" data-reveal style="--d:.08s">"A well-designed porch adds both character and functionality to your home" — an extra layer of insulation, a second barrier to entry and real kerb appeal. A rear porch is ideal for keeping muddy boots out of the house.</p>
        <div class="pv__bases">
          <div data-reveal><span class="idx">Base A</span><h3 class="h4">Traditional brick base</h3><p>Classic brickwork to match your home.</p></div>
          <div data-reveal style="--d:.06s"><span class="idx">Base B</span><h3 class="h4">Steel modular system</h3><p>"For a quicker, cleaner installation" — fully compliant with building regulations, with minimal on-site disruption.</p></div>
        </div>
        <ul class="spec">
          <li>All work carried out by our in-house teams</li>
          <li>Interiors finished by our in-house plasterer</li>
          <li>Electrics and plumbing coordinated with trusted local professionals — one point of contact</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--bone" id="verandas" aria-labelledby="ve-h">
    <div class="wrap pv pv--rev">
      <div>
        <p class="label sec-head__kicker">Verandas · Deponti</p>
        <h2 id="ve-h" data-reveal>Outdoor rooms,<br /><em>whatever the weather.</em></h2>
        <p class="lede" data-reveal style="--d:.08s">We've partnered with leading manufacturer Deponti to supply and install premium aluminium verandas across Devon and Somerset — by the pool, over a hot tub, or tucked in a quiet corner.</p>
        <dl class="ve__facts">
          <div data-reveal><dt>Span</dt><dd>The Giallo model can span up to six metres using only two posts</dd></div>
          <div data-reveal style="--d:.05s"><dt>Roofing</dt><dd>Clear, opal, ultra clear or glass</dd></div>
          <div data-reveal style="--d:.1s"><dt>Extras</dt><dd>Sidewalls, side gables, LED lighting and sliding glass doors</dd></div>
          <div data-reveal style="--d:.15s"><dt>Mounting</dt><dd>Fixed to your home or freestanding</dd></div>
        </dl>
      </div>
      <div class="pv__art ve__art" data-reveal>
        <svg viewBox="0 0 300 220" fill="none" stroke="currentColor" class="draw" aria-hidden="true">
          <line x1="10" y1="200" x2="290" y2="200" />
          <rect x="10" y="30" width="16" height="170" />
          <path d="M26 46 L270 70 L270 80 L26 58 Z" />
          {[60, 110, 160, 210].map((x) => <line x1={x} y1={49 + (x - 26) * 0.098} x2={x} y2={61 + (x - 26) * 0.09} />)}
          <rect x="262" y="78" width="8" height="122" />
          <rect x="40" y="80" width="0.1" height="0.1" />
          <path d="M60 200 V170 H120 V200 M70 170 V150 H110 V170" />
          <text x="150" y="216" text-anchor="middle" font-size="8" stroke="none" fill="currentColor" font-family="var(--f-mono)">SPAN · UP TO 6 M (GIALLO)</text>
          <line x1="26" y1="190" x2="262" y2="190" stroke-dasharray="3 3" />
        </svg>
      </div>
    </div>
  </section>
</Base>

<style>
  h2 em { color: var(--clay); }
  .hup h2 em { color: var(--gold); }
  .cs__tabs { margin-bottom: 28px; }
  .cs__body { display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: clamp(16px, 3vw, 40px); align-items: start; }
  .cs__fig { margin: 0; display: grid; gap: 10px; background: var(--paper); border: 1px solid var(--line); padding: 18px; }
  .cs__svg { width: 100%; height: auto; overflow: visible; }
  .cs__house { fill: var(--ink); }
  .cs__t { font-family: var(--f-mono); font-size: 9px; letter-spacing: .14em; fill: var(--paper); }
  .cs__plan { fill: color-mix(in srgb, var(--sea) 30%, transparent); stroke: var(--sea-deep); stroke-width: 2; transition: d .8s var(--ease); }
  .cs__wallbg { fill: var(--paper-2); }
  .cs__elev { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .cs__elev :global(*) { animation: csIn .8s var(--ease) both; }
  @keyframes csIn { from { opacity: 0; } }
  .cs__ground { stroke: var(--ink); stroke-width: 2; }
  .cs__copy { display: grid; gap: 16px; }
  .cs__txt h3 { margin-bottom: 12px; }
  .cs__txt p { color: var(--ink-soft); font-size: 15.5px; margin: 0; }
  .cs__copy .spec { font-size: 14px; }
  @media (max-width: 1000px) { .cs__body { grid-template-columns: 1fr 1fr; } .cs__copy { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .cs__body { grid-template-columns: 1fr; } }

  .roofs__grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .roofs h2 { margin-bottom: 26px; }
  .roofs .spec { margin: 28px 0; font-size: 15px; }
  .roofs__ctas { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
  .ba { position: relative; margin: 0; }
  .ba__svg { width: 100%; height: auto; display: block; }
  .ba__t { font-family: var(--f-mono); font-size: 11px; letter-spacing: .12em; fill: var(--ink); }
  .ba__range { position: absolute; inset: 0; width: 100%; height: calc(100% - 22px); opacity: 0; cursor: ew-resize; margin: 0; }
  .ba figcaption { margin-top: 8px; }
  .ba:has(.ba__range:focus-visible) { outline: 2px solid var(--clay); outline-offset: 4px; }
  @media (max-width: 900px) { .roofs__grid { grid-template-columns: 1fr; } }

  .hup__grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-light); }
  .hup__c { padding: 24px 22px 24px 0; display: grid; gap: 10px; align-content: start; }
  .hup__c + .hup__c { border-left: 1px solid var(--line-light); padding-left: 22px; }
  .hup__c p { font-size: 14.5px; opacity: .75; margin: 0; }
  .hup__types { display: flex; flex-wrap: wrap; gap: 8px; margin: 34px 0 18px; }
  .hup__types .chip { border-color: rgba(243,239,231,.3); display: inline-flex; align-items: center; }
  .hup__note { font-size: 13px; opacity: .6; max-width: 70ch; margin-bottom: 28px; }
  @media (max-width: 900px) { .hup__grid { grid-template-columns: 1fr 1fr; } .hup__c:nth-child(3) { border-left: 0; padding-left: 0; } }
  @media (max-width: 520px) { .hup__grid { grid-template-columns: 1fr; } .hup__c + .hup__c { border-left: 0; padding-left: 0; border-top: 1px solid var(--line-light); } }

  .pv { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 100px); align-items: center; }
  .pv--rev { grid-template-columns: 1.3fr 1fr; }
  .pv h2 { margin-bottom: 24px; }
  .pv__art { color: var(--sea-deep); max-width: 380px; justify-self: center; width: 100%; }
  .pv__bases { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 28px 0; }
  .pv__bases > div { border: 1px solid var(--line); padding: 18px; display: grid; gap: 8px; align-content: start; background: var(--bone); }
  .pv__bases p { font-size: 14px; color: var(--ink-mute); margin: 0; }
  .ve__facts { margin: 28px 0 0; display: grid; border-top: 1px solid var(--line); }
  .ve__facts div { display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .ve__facts dt { font-family: var(--f-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; opacity: .6; padding-top: 3px; }
  .ve__facts dd { margin: 0; }
  @media (max-width: 900px) { .pv, .pv--rev { grid-template-columns: 1fr; } .pv__art { max-width: 260px; justify-self: start; } .pv__bases { grid-template-columns: 1fr; } }
</style>

<script>
  const data = JSON.parse(document.getElementById('cs-data').textContent);
  const cs = document.getElementById('cs');
  cs?.querySelector('.cs__tabs').addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b) return;
    const i = +b.dataset.i;
    cs.querySelectorAll('.cs__tabs button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    document.getElementById('cs-plan').setAttribute('d', data[i].plan);
    document.getElementById('cs-elev').innerHTML = data[i].elev;
    cs.querySelectorAll('.cs__txt').forEach((t) => (t.hidden = +t.dataset.i !== i));
  });
  // before / after roof
  const r = document.getElementById('ba-range');
  const upd = () => {
    const x = Math.max(24, Math.min(576, (+r.value / 100) * 600));
    document.getElementById('ba-cliprect').setAttribute('x', x); document.getElementById('ba-cliprect').setAttribute('width', 600 - x);
    const l = document.getElementById('ba-line'); l.setAttribute('x1', x); l.setAttribute('x2', x);
    document.getElementById('ba-knob').setAttribute('transform', `translate(${x} 380)`);
  };
  r?.addEventListener('input', upd);
</script>
