---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {
  title = 'Coastal Windows & Conservatories — Newton Abbot, Devon',
  description = 'Windows, doors, conservatories and home improvements, made to measure and installed across the South West since 1988. Visit our Newton Abbot showroom.',
  footerCta = true,
  bodyClass = '',
  headerTheme = 'light',
} = Astro.props;
const fullTitle = title.includes('Coastal') ? title : `${title} — Coastal Windows & Conservatories`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1618" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { if (sessionStorage.getItem('cw-fold')) document.documentElement.classList.add('fold-in'); } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness',
      name: 'Coastal Windows & Conservatories', telephone: '+441803299937',
      address: { '@type': 'PostalAddress', streetAddress: 'Silverhills Buildings, Silverhills Road, Decoy Industrial Estate', addressLocality: 'Newton Abbot', addressRegion: 'Devon', postalCode: 'TQ12 5LZ', addressCountry: 'GB' },
      foundingDate: '1988', areaServed: ['Cornwall', 'Devon', 'Somerset', 'Dorset'],
    })} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-header-start={headerTheme}>
      <slot />
    </main>
    <Footer cta={footerCta} />

    <!-- Bifold page transition: glazed aluminium panels that fold across the screen -->
    <div class="fold" id="fold" aria-hidden="true">
      <div class="fold__track">
        {Array.from({ length: 6 }).map((_, i) => (
          <div class="fold__p" data-i={i}>
            <div class="fold__glass"></div>
            {i === 0 && <div class="fold__handle"></div>}
          </div>
        ))}
      </div>
      <div class="fold__label"><span class="fold__label-k label">Opening</span><span class="fold__label-t" id="fold-label"></span></div>
    </div>

    <button class="concept-pill" id="concept-pill" type="button" aria-expanded="false" aria-controls="concept-note">
      <span class="concept-pill__dot"></span> Design concept
    </button>
    <div class="concept-note" id="concept-note" role="dialog" aria-label="About this concept" hidden>
      <p><strong>An unofficial concept by Conquer AI.</strong> Created to show what a new website could do for Coastal Windows &amp; Conservatories. Not the official site; not commissioned or endorsed by the company.</p>
      <p>Interactive tools and forms are demonstrations — nothing is sent. Visuals are generated illustrations, not photographs of real installations. Business details are taken from the company's current website.</p>
      <a href="https://www.coastal-windows.co.uk/" target="_blank" rel="noopener">Official site: coastal-windows.co.uk ↗</a>
    </div>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>

<style is:global>
  .fold { position: fixed; inset: 0; z-index: 200; pointer-events: none; perspective: 2200px; visibility: hidden; }
  .fold.is-active, .fold-in .fold { visibility: visible; pointer-events: auto; }
  .fold__track { position: absolute; inset: 0; transform-style: preserve-3d; }
  .fold__p {
    position: absolute; top: 0; bottom: 0; width: calc(100% / 6 + 1px);
    background: #1a2427;
    transform-origin: 0 50%;
    backface-visibility: hidden;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
    will-change: transform;
  }
  .fold__glass {
    position: absolute; inset: 14px 12px;
    background:
      linear-gradient(115deg, rgba(255,255,255,0) 30%, rgba(255,255,255,.07) 42%, rgba(255,255,255,0) 52%),
      linear-gradient(180deg, #23363a, #0f1b1d);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.05);
  }
  .fold__p::after { content: ''; position: absolute; inset: 0; background: var(--shade, transparent); pointer-events: none; }
  .fold__handle { position: absolute; left: 4px; top: 50%; width: 4px; height: 90px; margin-top: -45px; border-radius: 3px; background: linear-gradient(90deg, #8d9799, #d3d8d8 50%, #6f7a7c); }
  .fold__label { position: absolute; inset: auto 0 calc(50% - 30px); text-align: center; color: var(--paper); display: grid; gap: 10px; opacity: 0; transition: opacity .3s; }
  .fold.show-label .fold__label { opacity: 1; }
  .fold__label-t { font-family: var(--f-display); font-style: italic; font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -0.02em; }
  .fold__label-k { opacity: .55; }
  .fold-in .fold__p { transform: none; }

  .concept-pill {
    position: fixed; left: 14px; bottom: 14px; z-index: 70;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; cursor: pointer;
    color: var(--ink);
  }
  .concept-pill__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--clay); box-shadow: 0 0 0 3px color-mix(in srgb, var(--clay) 25%, transparent); }
  .concept-note {
    position: fixed; left: 14px; bottom: 58px; z-index: 71; width: min(380px, calc(100vw - 28px));
    background: var(--ink); color: var(--paper); padding: 18px 20px; font-size: 13.5px; line-height: 1.5;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,.5);
  }
  .concept-note p { margin: 0 0 10px; opacity: .85; }
  .concept-note a { color: var(--gold); font-family: var(--f-mono); font-size: 11px; letter-spacing: .06em; }
  .menu-open .concept-pill { opacity: 0; pointer-events: none; }
</style>
